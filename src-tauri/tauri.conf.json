{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pastable Prompts",
  "version": "0.1.5",
  "identifier": "dev.pastableprompts.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Pastable Prompts",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#1b1d23",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
